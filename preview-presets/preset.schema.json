{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MEO Enhanced custom preview preset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "description", "themes"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1, "description": "Configuration format version. Currently 1." },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$", "description": "Stable ID; reimporting this ID updates the saved preset." },
    "name": {
      "oneOf": [
        { "$ref": "#/definitions/nameText" },
        { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "en": { "$ref": "#/definitions/nameText" }, "zh-CN": { "$ref": "#/definitions/nameText" } } }
      ],
      "description": "Menu name. A string appears in both languages; en / zh-CN follows the UI language and falls back to the available translation."
    },
    "description": {
      "oneOf": [
        { "$ref": "#/definitions/descriptionText" },
        { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "en": { "$ref": "#/definitions/descriptionText" }, "zh-CN": { "$ref": "#/definitions/descriptionText" } } }
      ],
      "description": "Preset explanation, including any relevant differences. A string appears in both UI languages; en / zh-CN text follows the UI language and falls back to the available translation."
    },
    "base": { "enum": ["default", "github-readme"], "default": "default", "description": "Fixed base document styles and light/dark palettes, without editor theme colors. Custom presets use MEO Markdown rendering and independent controls." },
    "controls": {
      "type": "object", "additionalProperties": false,
      "properties": { "fontFamily": { "$ref": "#/definitions/fontControl" }, "htmlComments": { "$ref": "#/definitions/control" }, "codeColoring": { "$ref": "#/definitions/control" } },
      "description": "Font defaults to fixed for compatibility; editable allows a per-preset body font override. Other omitted controls are editable and use the user's current settings. Fixed controls are hidden."
    },
    "styles": {
      "type": "object", "additionalProperties": false,
      "properties": { "common": { "$ref": "#/definitions/cssPath" } }
    },
    "themes": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": { "light": { "$ref": "#/definitions/theme" }, "dark": { "$ref": "#/definitions/theme" } },
      "description": "Provide light, dark, or both. A single theme disables the theme switch."
    },
    "author": { "type": "string", "minLength": 1, "maxLength": 500 },
    "version": { "type": "string", "minLength": 1, "maxLength": 500 },
    "source": { "type": "string", "minLength": 1, "maxLength": 500 },
    "license": { "type": "string", "minLength": 1, "maxLength": 500 }
  },
  "definitions": {
    "nameText": { "type": "string", "minLength": 1, "maxLength": 80 },
    "fontControl": {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": { "mode": { "enum": ["editable", "fixed"] } }
    },
    "descriptionText": { "type": "string", "minLength": 1, "maxLength": 500 },
    "control": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "editable" } } },
        { "type": "object", "additionalProperties": false, "required": ["mode", "value"], "properties": { "mode": { "const": "fixed" }, "value": { "type": "boolean" } } }
      ]
    },
    "cssPath": { "type": "string", "maxLength": 240, "pattern": "^[a-zA-Z0-9_-]+(?:[./][a-zA-Z0-9_-]+)*\\.css$", "description": "Relative CSS path inside this preset folder. No absolute paths or parent-directory traversal." },
    "theme": {
      "type": "object", "additionalProperties": false, "required": ["css"],
      "properties": {
        "css": { "$ref": "#/definitions/cssPath" },
        "codeTheme": { "enum": ["light-plus", "dark-plus", "github-light-default", "github-dark-default"], "description": "Fixed syntax palette used when code coloring is enabled; does not enable or lock coloring or change CSS backgrounds. Omit for Light+/Dark+ on the Default base, or GitHub light/dark on the GitHub base." }
      }
    }
  }
}
