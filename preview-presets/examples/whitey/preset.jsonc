{
  "$schema": "../../preset.schema.json",
  "schemaVersion": 1,
  "id": "whitey",
  "name": {
    "en": "Typora Whitey",
    "zh-CN": "Typora Whitey"
  },
  "description": {
    "en": "Centered headings and fine dividers inspired by Typora Whitey, with light and dark themes.",
    "zh-CN": "参考 Typora Whitey 的居中标题与细分隔线，提供浅色与深色主题。"
  },
  "base": "default",
  "controls": {
    "fontFamily": {
      "mode": "editable"
    },
    "codeColoring": {
      "mode": "editable"
    },
    "htmlComments": {
      "mode": "editable"
    }
  },
  "styles": {
    "common": "common.css"
  },
  "themes": {
    "light": {
      "css": "light.css",
      "codeTheme": "light-plus"
    },
    "dark": {
      "css": "dark.css",
      "codeTheme": "dark-plus"
    }
  },
  "author": "MEO Enhanced contributors",
  "version": "1.1.0",
  "source": "https://github.com/typora/typora-default-themes/blob/master/themes/whitey.css",
  "license": "MIT"
}
