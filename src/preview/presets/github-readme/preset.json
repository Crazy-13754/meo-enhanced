{
  "$schema": "../preset.schema.json",
  "schemaVersion": 1,
  "id": "github-readme",
  "name": { "en": "GitHub README", "zh-CN": "GitHub README" },
  "description": {
    "en": "Local approximation of GitHub README.\n\nDifference from GitHub README: GitHub renders GeoJSON / TopoJSON as interactive maps and STL as interactive 3D models; this preset displays all three as code blocks.",
    "zh-CN": "GitHub README 的本地近似预览。\n\n与真实 GitHub README 的差异：GitHub 将 GeoJSON / TopoJSON 渲染为交互地图、STL 渲染为交互 3D 模型；本预设均显示为代码块。"
  },
  "renderer": "github-readme",
  "author": "MEO Enhanced contributors",
  "version": "1.0.0",
  "license": "MIT",
  "styles": {
    "light": "github-markdown-light.css",
    "dark": "github-markdown-dark.css"
  },
  "source": {
    "url": "https://github.com/sindresorhus/github-markdown-css",
    "version": "5.9.0",
    "commit": "265b22aa79815418195f453352456d5784bb7580"
  },
  "defaults": { "contentWidth": "responsive" },
  "controls": {
    "fontFamily": { "mode": "fixed" },
    "appearance": { "mode": "editable", "options": ["auto", "light", "dark"] },
    "codeColoring": { "mode": "fixed", "value": true },
    "htmlComments": { "mode": "fixed", "value": false },
    "contentWidth": { "mode": "fixed" }
  },
  "notes": []
}
