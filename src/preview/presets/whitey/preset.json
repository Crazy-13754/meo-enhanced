{
  "$schema": "../preset.schema.json",
  "schemaVersion": 1,
  "id": "whitey",
  "name": { "en": "Typora Whitey", "zh-CN": "Typora Whitey" },
  "description": {
    "en": "Centered headings and fine dividers inspired by Typora Whitey, with light and dark themes.",
    "zh-CN": "参考 Typora Whitey 的居中标题与细分隔线，提供浅色与深色主题。"
  },
  "renderer": "meo",
  "styles": { "light": "light.css", "dark": "dark.css" },
  "author": "MEO Enhanced contributors",
  "version": "1.1.0",
  "source": { "url": "https://github.com/typora/typora-default-themes/blob/master/themes/whitey.css" },
  "license": "MIT",
  "defaults": { "contentWidth": "responsive" },
  "controls": {
    "fontFamily": { "mode": "editable" },
    "appearance": { "mode": "editable", "options": ["auto", "light", "dark"] },
    "codeColoring": { "mode": "editable" },
    "htmlComments": { "mode": "editable" },
    "contentWidth": { "mode": "fixed" }
  },
  "notes": []
}
