{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extension=vadimmelnicuk.meo"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "build"
    },
    {
      "name": "Run with Markmap",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extension=vadimmelnicuk.meo",
        "--extensionDevelopmentPath=${input:markmapExtensionPath}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "build"
    }
  ],
  "inputs": [
    {
      "id": "markmapExtensionPath",
      "type": "promptString",
      "description": "Path to the separately built meoenhancedmarkmap extension"
    }
  ]
}
